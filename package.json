{
  "name": "guidely",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight, framework-agnostic guided product tours: spotlight, tooltip and keyboard-accessible steps.",
  "keywords": [
    "product-tour",
    "guided-tour",
    "onboarding",
    "walkthrough",
    "spotlight",
    "tooltip",
    "accessibility",
    "typescript",
    "framework-agnostic"
  ],
  "homepage": "https://github.com/ahlgren1234/guidely#readme",
  "bugs": "https://github.com/ahlgren1234/guidely/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahlgren1234/guidely.git"
  },
  "license": "MIT",
  "author": "Peter Anyawantana",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
